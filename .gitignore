# =============================================================
# INDRA — Git Ignore Configuration
# =============================================================

# -----------------------------------------------
# SECURITY — Environment Files & Secrets
# -----------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------
# Node.js / Frontend
# -----------------------------------------------
node_modules/
dist/
build/
.npm-cache/
# Allow pre-built frontend distribution for unified cloud deployment
!apps/frontend/dist/
!apps/frontend/dist/**


# -----------------------------------------------
# Python / Backend
# -----------------------------------------------
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
apps/backend-python/dist/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.coveragerc

# -----------------------------------------------
# Runtime / Generated Data
# -----------------------------------------------
# ChromaDB local vector store — can be rebuilt by re-ingesting documents
apps/backend-python/chroma_db/

# Runtime uploaded files — not part of source code
apps/backend-python/uploads/

# -----------------------------------------------
# Logs
# -----------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------
# Temporary / AI Tooling Directories
# -----------------------------------------------
.tmp/
.agents/
.codex/

# -----------------------------------------------
# OS-Generated Files
# -----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------
# IDE / Editor Specific
# -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------
# Build Artifacts
# -----------------------------------------------
*.tsbuildinfo
vite.config.ts.timestamp-*

# Whitelist compiled frontend for unified cloud deployment
!apps/frontend/dist/
!apps/frontend/dist/**

