# INDRA — Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================

# Google Gemini API Key
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port
PORT=5000

# MongoDB Connection URI
# Local: mongodb://localhost:27017/indra_db
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/indra_db
MONGODB_URI=mongodb://localhost:27017/indra_db

# ChromaDB Local Persistence Path (relative to backend directory)
CHROMA_DB_PATH=./chroma_db

# JWT Secret Key (use a strong random string in production)
JWT_SECRET=change_this_to_a_strong_random_secret

# JWT Token Expiry
JWT_EXPIRES_IN=24h

# Seed database with demo assets and users on first boot
# Set to false after the first run to skip reseeding
SEED_DB=true
